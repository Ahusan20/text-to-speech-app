{
  "info": {
    "name": "Vox Studio Text-to-Speech API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
    },
    {
      "name": "Voices",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/voices" }
    },
    {
      "name": "Voices by Language",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/voices?language=en-US" }
    },
    {
      "name": "Generate Speech",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Hello, welcome to Vox Studio.\",\n  \"language\": \"en-US\",\n  \"voice\": \"sapi-female\"\n}"
        },
        "url": "{{baseUrl}}/api/tts"
      }
    },
    {
      "name": "Invalid Empty Text",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"\",\n  \"language\": \"en-US\",\n  \"voice\": \"sapi-female\"\n}"
        },
        "url": "{{baseUrl}}/api/tts"
      }
    },
    {
      "name": "Invalid Voice",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Invalid voice test\",\n  \"language\": \"en-US\",\n  \"voice\": \"invalid-voice\"\n}"
        },
        "url": "{{baseUrl}}/api/tts"
      }
    },
    {
      "name": "AI Enhance",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"vox studio converts text into speech.\",\n  \"mode\": \"grammar\"\n}"
        },
        "url": "{{baseUrl}}/api/ai/enhance"
      }
    }
  ]
}
